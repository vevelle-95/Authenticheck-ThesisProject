{
  "manifest_version": 3,
  "name": "AuthentiCheck",
  "version": "0.1.0",
  "description": "Review-quality and sentiment insights for Shopee and Lazada product pages.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.shopee.ph/*",
    "*://*.lazada.com.ph/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AuthentiCheck",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.shopee.ph/*", "*://*.lazada.com.ph/*"],
      "js": [
        "extractors/common.js",
        "extractors/shopee.js",
        "extractors/lazada.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["*://*.shopee.ph/*", "*://*.lazada.com.ph/*"]
    }
  ]
}
